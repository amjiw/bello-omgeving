# Kopieer naar .env en vul in. Dit bestand hoort NIET in Git.
# Versie van de omgeving: latest (standaard) of een datumtag zoals 2026.11.04 om terug te draaien
BELLO_VERSIE=latest
# Welke wereld Webots laadt: max_wereld.wbt (standaard) of max_mqtt_wereld.wbt (luistermodus)
MAX_WERELD=max_wereld.wbt
# AI-tutor, taalmodellen in de cloud (persoonlijke sleutels: niet delen, niet in Git). De tutor probeert ze
# in deze volgorde en valt terug op het lokale model (profiel ai-lokaal).
# Groq (standaard): gratis tier zonder betaalgegevens, account op console.groq.com (e-mail,
# Google of GitHub), sleutel onder API Keys; limiet per sleutel (~30/min, ~1000/dag)
GROQ_API_KEY=
# Optioneel (docent): Ollama Cloud vraagt sinds 2026 een tegoed (HTTP 402 zonder);
# Hetzner Inference vraagt betaalgegevens bij het account. Beide geen studentroute.
OLLAMA_API_KEY=
HETZNER_API_KEY=
# hints (standaard: de tutor geeft alleen hints) of vrij (docent: gewone code-assistent)
TUTOR_MODUS=hints
